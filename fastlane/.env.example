# ----------------------------------------------------------------------------
#  App Store Connect API Key の設定テンプレート
#  このファイルを fastlane/.env にコピーして値を埋めてください（.env は Git 管理外）。
#
#  API Key の発行:
#    App Store Connect > ユーザとアクセス > 統合 > App Store Connect API
#    ロールは「App Manager」以上が必要です。.p8 は一度しかダウンロードできません。
# ----------------------------------------------------------------------------

# API Key の Key ID（例: 2X9R4HXF34）
ASC_KEY_ID=

# API Key の Issuer ID（例: 57246542-96fe-1a63-e053-0824d011072a）
ASC_ISSUER_ID=

# --- ローカル実行時 ----------------------------------------------------------
# ダウンロードした .p8 ファイルへのパス（リポジトリ外に置くことを推奨）
ASC_KEY_FILEPATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# --- CI 実行時 ---------------------------------------------------------------
# .p8 を Base64 化した文字列。ASC_KEY_FILEPATH より優先度は低く、
# ASC_KEY_FILEPATH が未設定のときにこちらが使われます。
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
# GitHub Actions では Secrets に登録し、env: で渡してください。
# ASC_KEY_CONTENT=

# --- GitHub Release 作成用 ---------------------------------------------------
# repo スコープを持つ Personal Access Token。
# 未設定の場合、release レーンは GitHub Release の作成のみスキップします。
GITHUB_TOKEN=
