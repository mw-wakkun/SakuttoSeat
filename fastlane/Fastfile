# ============================================================================
#  SakuttoSeat / fastlane
# ----------------------------------------------------------------------------
#  認証は App Store Connect API Key (.p8) を前提とする。
#  必要な環境変数は fastlane/.env.example を参照。
#
#  実行できるレーンは 2 つ:
#    bundle exec fastlane ios beta                  # TestFlight へ配信
#    bundle exec fastlane ios release version:1.8.0 # App Store へ申請用アップロード
# ============================================================================

require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

# ---------------------------------------------------------------------------
#  プロジェクト定数
#  ※ Bundle ID や署名方式などの Xcode 側の設定はここでは一切上書きしない
# ---------------------------------------------------------------------------
XCODEPROJ   = "SakuttoSeat.xcodeproj".freeze
SCHEME      = "SakuttoSeat".freeze
TARGET      = "SakuttoSeat".freeze
OUTPUT_DIR  = "build".freeze
GITHUB_REPO = "mw-wakkun/SakuttoSeat".freeze

# ---------------------------------------------------------------------------
#  ヘルパー（fastlane アクションを伴わない純粋な Ruby 処理）
# ---------------------------------------------------------------------------

# xcodebuild の -authenticationKeyPath には .p8 の実ファイルパスが必要になる。
# CI では Base64 文字列で API Key を渡すため、その場合は一時ファイルへ復号して書き出す。
def resolve_p8_filepath
  filepath = ENV["ASC_KEY_FILEPATH"].to_s
  return File.expand_path(filepath) unless filepath.empty?

  tmp_path = File.join(Dir.tmpdir, "asc_api_key_#{ENV['ASC_KEY_ID']}.p8")
  File.write(tmp_path, Base64.decode64(ENV["ASC_KEY_CONTENT"].to_s))
  File.chmod(0o600, tmp_path)
  tmp_path
end

# 一時的に書き出した .p8 を削除する（ローカルの .p8 は削除しない）
def cleanup_tmp_p8
  return unless ENV["ASC_KEY_FILEPATH"].to_s.empty?

  tmp_path = File.join(Dir.tmpdir, "asc_api_key_#{ENV['ASC_KEY_ID']}.p8")
  File.delete(tmp_path) if File.exist?(tmp_path)
end

# 自動署名のまま xcodebuild に証明書を自動発行させるための引数を組み立てる
def provisioning_xcargs(api_key)
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{resolve_p8_filepath.shellescape}",
    "-authenticationKeyID #{api_key[:key_id].to_s.shellescape}",
    "-authenticationKeyIssuerID #{api_key[:issuer_id].to_s.shellescape}"
  ].join(" ")
end

platform :ios do
  before_all do
    # CI 上では専用の一時キーチェーンを作成する（ローカル実行では何もしない）
    setup_ci if ENV["CI"]
  end

  after_all { cleanup_tmp_p8 }
  error { |_lane, _exception| cleanup_tmp_p8 }

  # =========================================================================
  #  Public Lanes
  # =========================================================================

  desc "TestFlight へビルドを配信する（ビルド番号のみ更新／Git 操作なし）"
  lane :beta do |options|
    api_key = fetch_api_key

    # version: 指定時はマーケティングバージョンも更新する。
    # 未指定ならビルド番号のみ +1。skip_increment:true は再試行用。
    if options[:version]
      bump_version(version: options[:version])
    elsif !options[:skip_increment]
      increment_build_number(xcodeproj: XCODEPROJ)
    end

    ipa_path = build_signed_ipa(api_key: api_key)

    # TestFlight へアップロード（内部テスター向け、処理完了は待たない）
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      # Info.plist の ITSAppUsesNonExemptEncryption=false と揃える
      uses_non_exempt_encryption: false
    )

    UI.important("#{XCODEPROJ} のビルド番号が変更されています。コミットの要否を確認してください。")
  end

  desc "App Store Connectへのビルド・アップロード・タグ付け・GitHub Releaseの全自動化"
  lane :release do |options|
    api_key = fetch_api_key

    # 1. バージョン／ビルド番号の更新
    bump_version(version: options[:version])

    # 2. 証明書の解決とビルド（beta レーンと共通）
    ipa_path = build_signed_ipa(api_key: api_key)

    # 3. App Store Connect へアップロード
    #    メタデータとスクリーンショットは App Store Connect 上で管理するため送信しない
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      force: true, # HTML プレビューの確認プロンプトを出さない
      # precheck は API Key 認証だと App 内課金を検査できないため対象外にする
      precheck_include_in_app_purchases: false
    )

    # 4. コミット・タグ付け・push・GitHub Release
    publish_git_release
  end

  # =========================================================================
  #  Private Lanes（beta / release の共通部品）
  # =========================================================================

  desc "App Store Connect API Key (.p8) を読み込んで認証情報を組み立てる"
  private_lane :fetch_api_key do
    key_id    = ENV["ASC_KEY_ID"].to_s
    issuer_id = ENV["ASC_ISSUER_ID"].to_s
    filepath  = ENV["ASC_KEY_FILEPATH"].to_s # ローカル実行: .p8 のファイルパス
    content   = ENV["ASC_KEY_CONTENT"].to_s  # CI 実行: .p8 を Base64 化した文字列

    if key_id.empty? || issuer_id.empty? || (filepath.empty? && content.empty?)
      UI.user_error!(<<~MESSAGE)
        App Store Connect API Key が設定されていません。
        fastlane/.env.example をコピーして fastlane/.env を作成し、以下を設定してください。

          ASC_KEY_ID       … API Key の Key ID
          ASC_ISSUER_ID    … API Key の Issuer ID
          ASC_KEY_FILEPATH … ローカル実行時。.p8 ファイルへのパス
          ASC_KEY_CONTENT  … CI 実行時。.p8 を Base64 化した文字列
                              (base64 -i AuthKey_XXXX.p8 | pbcopy)
      MESSAGE
    end

    # key_filepath と key_content は排他指定のため、どちらか一方だけを渡す
    if filepath.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: content,
        is_key_content_base64: true
      )
    else
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: filepath
      )
    end
  end

  desc "証明書・プロファイルを自動解決しつつ配布用 ipa をビルドする"
  private_lane :build_signed_ipa do |options|
    # 【証明書・プロファイル】
    # Xcode プロジェクトの自動署名は変更しない。export だけ sigh の
    # App Store プロファイルを使う（クラウド署名の権限エラーを避ける）。
    get_provisioning_profile(
      api_key: options[:api_key],
      app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
      force: ENV["FORCE_PROFILE"].to_s == "1",
      include_all_certificates: true
    )

    signing_args = provisioning_xcargs(options[:api_key])

    # 【ビルド】scheme からアーカイブし、App Store 配布用に署名した ipa を書き出す
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "#{SCHEME}.ipa",
      clean: true,
      # gym は archive 用の xcargs を exportArchive にも引き継ぐ。
      # ここに export_xcargs を重ねると引数が二重になり xcodebuild が exit 64 で落ちる。
      xcargs: signing_args,
      export_options: {
        signingStyle: "automatic",
        teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
      }
    )
  end

  desc "バージョン番号とビルド番号を更新する"
  private_lane :bump_version do |options|
    new_version = options[:version].to_s

    # version: が指定されたときだけマーケティングバージョンを更新する
    unless new_version.empty?
      warn_if_not_newer(version: new_version)
      increment_version_number(
        version_number: new_version,
        xcodeproj: XCODEPROJ
      )
    end

    # ビルド番号は毎回 +1（同一ビルド番号の再アップロードは受け付けられないため）
    increment_build_number(xcodeproj: XCODEPROJ)
  end

  desc "リリースコミット・タグ付け・push・GitHub Release の作成"
  private_lane :publish_git_release do
    version = get_version_number(xcodeproj: XCODEPROJ, target: TARGET)
    build   = get_build_number(xcodeproj: XCODEPROJ)

    # バージョン更新で書き換わるのは project.pbxproj だけなので、
    # 作業中の無関係な変更を巻き込まないようコミット対象を限定する
    git_commit(
      path: "#{XCODEPROJ}/project.pbxproj",
      message: "bump: Release v#{version} (#{build})"
    )
    add_git_tag(tag: "v#{version}")
    push_to_git_remote

    # GitHub Release を自動作成（リリースノートは GitHub 側で自動生成）
    github_token = ENV["GITHUB_TOKEN"].to_s
    if github_token.empty?
      UI.important("GITHUB_TOKEN が未設定のため、GitHub Release の作成をスキップしました。")
    else
      set_github_release(
        repository_name: GITHUB_REPO,
        api_token: github_token,
        name: "v#{version}",
        tag_name: "v#{version}",
        is_generate_release_notes: true
      )
    end
  end

  # 過去に 1.7.0 → 1.17.0 のような誤指定が起きているため、退行時は警告する
  private_lane :warn_if_not_newer do |options|
    current = get_version_number(xcodeproj: XCODEPROJ, target: TARGET)
    begin
      if Gem::Version.new(options[:version]) <= Gem::Version.new(current)
        UI.important("指定バージョン #{options[:version]} は現在の #{current} 以下です。意図した指定か確認してください。")
      end
    rescue ArgumentError
      UI.important("バージョン #{options[:version]} を解釈できませんでした。書式を確認してください。")
    end
  end
end
